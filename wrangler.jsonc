{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khaos-theory",
  "main": "worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "STRIPE_QUEUE_MODE": "required"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "STRIPE_EVENTS_QUEUE",
        "queue": "khaos-theory-stripe-events"
      }
    ],
    "consumers": [
      {
        "queue": "khaos-theory-stripe-events",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "khaos-theory-stripe-events-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khaos-theory-orders",
      "database_id": "f5255369-f75f-4c50-8ba8-3a3550b3e3c8",
      "preview_database_id": "khaos-theory-orders-local",
      "migrations_dir": "migrations"
    }
  ]
}
