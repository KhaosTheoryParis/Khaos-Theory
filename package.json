{
  "name": "khaos-theory",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "security:env": "node scripts/check-no-runtime-secrets-in-env.mjs",
    "test:queue": "pnpm security:env && tsc -p tsconfig.queue-tests.json && NODE_PATH=./node_modules node --test /tmp/khaos-theory-queue-tests/tests/*.test.js"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "jose": "^6.2.10",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pnpm": "11.19.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
